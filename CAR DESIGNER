<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signarama Car Studio - AI Vehicle Wrap Configurator</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- React & ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <!-- Babel Compiler -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-gray-950 text-gray-100 font-sans antialiased overflow-hidden">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    // Preset vehicle models
    const CAR_MODELS = [
      { id: 'ford-figo-2014', name: '2014 Ford Figo Hatchback', bodyType: 'Hatchback', baseLengthMm: 3795, baseWidthMm: 1680 },
      { id: 'toyota-hilux-2022', name: 'Toyota Hilux Double Cab Bakkie', bodyType: 'Bakkie', baseLengthMm: 5330, baseWidthMm: 1855 },
      { id: 'vw-polo-2020', name: 'VW Polo Hatchback', bodyType: 'Hatchback', baseLengthMm: 4053, baseWidthMm: 1751 },
      { id: 'ford-transit-2021', name: 'Ford Transit Panel Van', bodyType: 'PanelVan', baseLengthMm: 5531, baseWidthMm: 2059 },
      { id: 'toyota-fortuner-2023', name: 'Toyota Fortuner SUV', bodyType: 'SUV', baseLengthMm: 4795, baseWidthMm: 1855 },
      { id: 'bmw-m4-2022', name: 'BMW M4 Coupe', bodyType: 'Coupe', baseLengthMm: 4794, baseWidthMm: 1887 }
    ];

    // Default individual vehicle body parts (all start unwrapped / factory paint by default)
    const INITIAL_VEHICLE_PARTS = {
      bonnet: { id: 'bonnet', name: 'Bonnet / Hood', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1350, heightMm: 980, decalImage: null },
      roof: { id: 'roof', name: 'Roof Panel', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1850, heightMm: 1200, decalImage: null },
      leftDoorFront: { id: 'leftDoorFront', name: 'Left Front Door', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1050, heightMm: 850, decalImage: null },
      rightDoorFront: { id: 'rightDoorFront', name: 'Right Front Door', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1050, heightMm: 850, decalImage: null },
      leftDoorRear: { id: 'leftDoorRear', name: 'Left Rear Door', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 950, heightMm: 850, decalImage: null },
      rightDoorRear: { id: 'rightDoorRear', name: 'Right Rear Door', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 950, heightMm: 850, decalImage: null },
      rearTailgate: { id: 'rearTailgate', name: 'Rear Tailgate / Boot', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1250, heightMm: 750, decalImage: null },
      frontBumper: { id: 'frontBumper', name: 'Front Bumper', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1650, heightMm: 450, decalImage: null },
      rearBumper: { id: 'rearBumper', name: 'Rear Bumper', enabled: false, color: '#334155', finish: 'Gloss', widthMm: 1650, heightMm: 450, decalImage: null }
    };

    // AI Display Component for Renders
    function AiRenderDisplayCanvas({ aiImage, isGenerating, error, currentAngle, onExpandImage }) {
      if (isGenerating) {
        return (
          <div className="w-full h-full flex flex-col items-center justify-center p-8 text-center bg-gray-950/80 rounded-xl border border-gray-800">
            <div className="w-16 h-16 border-4 border-red-500 border-t-transparent rounded-full animate-spin mb-4"></div>
            <h3 className="text-lg font-bold text-white mb-1">Synthesizing Photorealistic AI View</h3>
            <p className="text-xs text-gray-400 max-w-md">
              Rendering {currentAngle} with custom vinyl finishes, base factory paint, and isolated panel decals via Gemini AI...
            </p>
          </div>
        );
      }

      if (error) {
        return (
          <div className="w-full h-full flex flex-col items-center justify-center p-8 text-center bg-gray-950 rounded-xl border border-red-900/50">
            <i className="fa-solid fa-triangle-exclamation text-3xl text-red-500 mb-3"></i>
            <h3 className="text-md font-bold text-white mb-1">AI Generation Notice</h3>
            <p className="text-xs text-red-300 max-w-md mb-4">{error}</p>
          </div>
        );
      }

      if (aiImage) {
        return (
          <div className="w-full h-full flex flex-col items-center justify-center relative group p-2">
            <img 
              src={aiImage} 
              alt={`AI Render - ${currentAngle}`}
              className="max-w-full max-h-[82vh] object-contain rounded-lg shadow-2xl border border-gray-800 cursor-pointer hover:brightness-110 transition"
              onClick={() => onExpandImage && onExpandImage(aiImage)}
              title="Click to view full-screen"
            />
            <div className="absolute top-4 right-4 flex gap-2">
              <button 
                onClick={() => onExpandImage && onExpandImage(aiImage)}
                className="bg-gray-800 hover:bg-gray-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow-lg transition flex items-center gap-1.5">
                <i className="fa-solid fa-expand"></i> Fullscreen
              </button>
              <a 
                href={aiImage} 
                download={`Signarama-${currentAngle.replace(/\s+/g, '-')}.png`}
                className="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow-lg transition flex items-center gap-1.5">
                <i className="fa-solid fa-download"></i> Download High-Res
              </a>
            </div>
            <div className="absolute bottom-4 left-4 bg-gray-900/90 border border-gray-800 backdrop-blur-md px-3 py-1.5 rounded-lg text-xs text-gray-300 font-mono">
              Perspective: <span className="text-white font-bold">{currentAngle}</span>
            </div>
          </div>
        );
      }

      return (
        <div className="w-full h-full flex flex-col items-center justify-center p-8 text-center bg-gray-950 rounded-xl border border-dashed border-gray-800">
          <i className="fa-solid fa-wand-magic-sparkles text-4xl text-gray-700 mb-3"></i>
          <h3 className="text-md font-bold text-gray-300 mb-1">No AI Render Generated Yet</h3>
          <p className="text-xs text-gray-500 max-w-sm mb-4">
            Select an angle (Front 3/4, Left Profile, Right Profile, Rear, or Roof/Top) and click <span className="text-red-400 font-semibold">"Generate AI Studio Render"</span> above.
          </p>
        </div>
      );
    }

    // Main App Component
    function SignaramaApp() {
      const [selectedModel, setSelectedModel] = useState(CAR_MODELS[0].id);
      const [baseCarColor, setBaseCarColor] = useState('#ffffff');
      const [isClearCarMode, setIsClearCarMode] = useState(false);
      const [vehicleParts, setVehicleParts] = useState(INITIAL_VEHICLE_PARTS);
      const [globalVinylColor, setGlobalVinylColor] = useState('#dc2626');
      const [globalFinish, setGlobalFinish] = useState('Gloss');
      
      const [activeTab, setActiveTab] = useState('ai'); // 'ai', 'panels', 'cutsheet'
      const [aiAngle, setAiAngle] = useState('Front 3/4 Left View');
      const [aiImage, setAiImage] = useState(null);
      const [isAiGenerating, setIsAiGenerating] = useState(false);
      const [aiError, setAiError] = useState(null);
      const [expandedImage, setExpandedImage] = useState(null);

      const selectedModelObj = CAR_MODELS.find(m => m.id === selectedModel) || CAR_MODELS[0];

      // Handle Image Upload for specific vehicle panel
      const handleImageUpload = (partKey, event) => {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => {
          setVehicleParts(prev => ({
            ...prev,
            [partKey]: {
              ...prev[partKey],
              enabled: true,
              decalImage: e.target.result
            }
          }));
        };
        reader.readAsDataURL(file);
      };

      // Remove decal image
      const removeDecal = (partKey) => {
        setVehicleParts(prev => ({
          ...prev,
          [partKey]: {
            ...prev[partKey],
            decalImage: null
          }
        }));
      };

      // Update part property
      const updatePartProp = (partKey, prop, value) => {
        setVehicleParts(prev => ({
          ...prev,
          [partKey]: {
            ...prev[partKey],
            [prop]: value
          }
        }));
      };

      // Apply Global Color and Finish to all panels
      const applyGlobalStyle = () => {
        setVehicleParts(prev => {
          const updated = { ...prev };
          Object.keys(updated).forEach(key => {
            updated[key] = {
              ...updated[key],
              color: globalVinylColor,
              finish: globalFinish
            };
          });
          return updated;
        });
      };

      // Calculate Total Wrapped Area in Square Meters
      const calculateTotalWrapArea = () => {
        let totalAreaMm2 = 0;
        Object.values(vehicleParts).forEach(part => {
          if (part.enabled) {
            totalAreaMm2 += (part.widthMm * part.heightMm);
          }
        });
        return (totalAreaMm2 / 1000000).toFixed(2); // Convert mm2 to m2
      };

      // Real Gemini AI Generation Engine using gemini-3.1-flash-image
      const generateAiVehicleRender = async () => {
        setIsAiGenerating(true);
        setAiError(null);

        try {
          // Gather all active uploaded decal images and instructions
          const activeDecals = [];
          const partInstructions = [];

          Object.values(vehicleParts).forEach(part => {
            if (part.enabled) {
              if (part.decalImage) {
                // Extract base64 payload & mimeType
                const match = part.decalImage.match(/^data:(image\/\w+);base64,(.+)$/);
                if (match) {
                  activeDecals.push({
                    mimeType: match[1],
                    data: match[2]
                  });
                  partInstructions.push(`- The graphic provided in image #${activeDecals.length} MUST be applied STRICTLY to the ${part.name} ONLY. Do not let it overflow onto adjacent car panels.`);
                }
              } else {
                partInstructions.push(`- The ${part.name} is wrapped in solid ${part.finish} vinyl with color code ${part.color}.`);
              }
            } else {
              partInstructions.push(`- The ${part.name} is UNWRAPPED factory paint.`);
            }
          });

          // Build system prompt for Gemini 3.1 Flash Image
          const basePaintDesc = isClearCarMode 
            ? "The unwrapped parts of the car should be transparent clear glass / X-Ray bodywork revealing the interior frame." 
            : `The unwrapped body parts have factory paint color ${baseCarColor}.`;

          const promptText = `Generate a ultra-realistic photorealistic studio photograph of a ${selectedModelObj.name} (${selectedModelObj.bodyType}).
Camera Angle / Perspective: ${aiAngle}.
Studio Lighting: Professional automotive photography lighting, clean dark reflective floor.
Base Body Finish: ${basePaintDesc}

Panel-Specific Wrap & Decal Instructions:
${partInstructions.join('\n')}

IMPORTANT GRAPHIC ISOLATION RULES:
1. Incorporate each attached graphic image accurately onto its assigned panel.
2. If an image is assigned to the Bonnet / Hood, render it strictly on the engine hood surface and do NOT bleed it onto the roof or windshield.
3. If an image is assigned to the Roof, place it exclusively on the roof panel.
4. Render high-resolution graphics cleanly with glossy wrap finish texture matching real vehicle vinyl wraps.`;

          // Prepare payload
          const contentsParts = [{ text: promptText }];
          activeDecals.forEach(decal => {
            contentsParts.push({
              inlineData: {
                mimeType: decal.mimeType,
                data: decal.data
              }
            });
          });

          const payload = {
            contents: [{
              role: 'user',
              parts: contentsParts
            }],
            generationConfig: {
              responseModalities: ['IMAGE'],
              imageConfig: { aspectRatio: "16:9" }
            }
          };

          const apiKey = "";
          const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`API error HTTP ${response.status}`);
          }

          const result = await response.json();
          const imagePart = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);

          if (imagePart && imagePart.inlineData) {
            const imageUrl = `data:${imagePart.inlineData.mimeType};base64,${imagePart.inlineData.data}`;
            setAiImage(imageUrl);
          } else {
            throw new Error("The AI model did not return an image part. Please try again.");
          }
        } catch (err) {
          console.error("AI Generation Error:", err);
          setAiError(err.message || "Failed to generate AI render. Please check your uploads and try again.");
        } finally {
          setIsAiGenerating(false);
        }
      };

      return (
        <div className="w-screen h-screen flex flex-col bg-gray-950 text-white overflow-hidden">
          
          {/* Top Navigation Bar */}
          <header className="bg-gray-900 border-b border-gray-800 px-6 py-3 flex items-center justify-between shrink-0">
            <div className="flex items-center gap-3">
              <div className="bg-red-600 w-9 h-9 rounded-xl flex items-center justify-center font-black text-xl tracking-tighter text-white shadow-lg shadow-red-600/30">
                S
              </div>
              <div>
                <h1 className="text-base font-bold tracking-tight text-white flex items-center gap-2">
                  SIGNARAMA CAR STUDIO <span className="text-[10px] bg-red-600/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded-full uppercase font-semibold">Pro AI Studio</span>
                </h1>
                <p className="text-[11px] text-gray-400">Commercial Vehicle Graphics & Wrap Production Configurator</p>
              </div>
            </div>

            {/* Navigation Tabs */}
            <div className="flex items-center bg-gray-950 p-1 rounded-xl border border-gray-800">
              <button 
                onClick={() => setActiveTab('ai')}
                className={`px-4 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-2 ${activeTab === 'ai' ? 'bg-red-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}>
                <i className="fa-solid fa-wand-magic-sparkles"></i> AI Render Engine
              </button>
              <button 
                onClick={() => setActiveTab('panels')}
                className={`px-4 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-2 ${activeTab === 'panels' ? 'bg-red-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}>
                <i className="fa-solid fa-layer-group"></i> Panel & Graphic Customizer
              </button>
              <button 
                onClick={() => setActiveTab('cutsheet')}
                className={`px-4 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-2 ${activeTab === 'cutsheet' ? 'bg-red-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}>
                <i className="fa-solid fa-ruler-combined"></i> mm Cut-Sheet Specifications
              </button>
            </div>
          </header>

          {/* Main Studio Body */}
          <div className="flex-1 flex overflow-hidden">

            {/* Left Sidebar Control Panel */}
            <div className="w-96 bg-gray-900 border-r border-gray-800 flex flex-col shrink-0 overflow-y-auto p-4 gap-5">
              
              {/* Vehicle Selection */}
              <div className="bg-gray-950 p-3.5 rounded-xl border border-gray-800">
                <label className="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-2">
                  1. Select Vehicle Template
                </label>
                <select 
                  value={selectedModel} 
                  onChange={(e) => setSelectedModel(e.target.value)}
                  className="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs font-medium text-white focus:outline-none focus:border-red-500">
                  {CAR_MODELS.map(car => (
                    <option key={car.id} value={car.id}>{car.name} ({car.bodyType})</option>
                  ))}
                </select>
              </div>

              {/* Base Factory Paint Color & Clear Mode */}
              <div className="bg-gray-950 p-3.5 rounded-xl border border-gray-800 flex flex-col gap-3">
                <div className="flex justify-between items-center">
                  <label className="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                    Base Factory Body Finish
                  </label>
                  <button 
                    onClick={() => setIsClearCarMode(!isClearCarMode)}
                    className={`px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase transition border ${isClearCarMode ? 'bg-cyan-500/20 border-cyan-500 text-cyan-300' : 'bg-gray-800 border-gray-700 text-gray-400'}`}>
                    <i className="fa-solid fa-cube mr-1"></i> {isClearCarMode ? 'Clear X-Ray Glass Mode' : 'Solid Factory Paint'}
                  </button>
                </div>
                {!isClearCarMode && (
                  <div className="flex items-center gap-3">
                    <input 
                      type="color" 
                      value={baseCarColor} 
                      onChange={(e) => setBaseCarColor(e.target.value)}
                      className="w-9 h-9 rounded-lg border-2 border-gray-700 cursor-pointer bg-transparent"
                    />
                    <span className="text-xs font-mono text-gray-300">{baseCarColor.toUpperCase()}</span>
                  </div>
                )}
              </div>

              {/* Quick Global Vinyl Color & Finish Applicator */}
              <div className="bg-gray-950 p-3.5 rounded-xl border border-gray-800 flex flex-col gap-3">
                <label className="text-xs font-semibold text-gray-400 uppercase tracking-wider block">
                  Quick Global Vinyl Style
                </label>
                <div className="flex items-center gap-2">
                  <input 
                    type="color" 
                    value={globalVinylColor} 
                    onChange={(e) => setGlobalVinylColor(e.target.value)}
                    className="w-8 h-8 rounded-lg border border-gray-700 cursor-pointer bg-transparent"
                  />
                  <select 
                    value={globalFinish} 
                    onChange={(e) => setGlobalFinish(e.target.value)}
                    className="bg-gray-900 border border-gray-700 rounded-lg px-2 py-1.5 text-xs text-white">
                    <option value="Gloss">Gloss Finish</option>
                    <option value="Matte">Matte Finish</option>
                    <option value="Satin">Satin Finish</option>
                    <option value="Metallic">Metallic Finish</option>
                  </select>
                  <button 
                    onClick={applyGlobalStyle}
                    className="bg-gray-800 hover:bg-gray-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition ml-auto">
                    Apply All
                  </button>
                </div>
              </div>

              {/* Individual Vehicle Body Panels */}
              <div className="flex flex-col gap-2">
                <h3 className="text-xs font-semibold text-gray-400 uppercase tracking-wider px-1">
                  Individual Body Panel Customization
                </h3>
                <div className="flex flex-col gap-2.5">
                  {Object.values(vehicleParts).map(part => (
                    <div key={part.id} className="bg-gray-950 p-3 rounded-xl border border-gray-800 flex flex-col gap-2">
                      <div className="flex items-center justify-between">
                        <label className="flex items-center gap-2 cursor-pointer">
                          <input 
                            type="checkbox" 
                            checked={part.enabled}
                            onChange={(e) => updatePartProp(part.id, 'enabled', e.target.checked)}
                            className="rounded border-gray-700 text-red-600 focus:ring-0 w-4 h-4"
                          />
                          <span className={`text-xs font-bold ${part.enabled ? 'text-white' : 'text-gray-500'}`}>{part.name}</span>
                        </label>
                        <div className="flex items-center gap-2">
                          <input 
                            type="color" 
                            value={part.color}
                            onChange={(e) => updatePartProp(part.id, 'color', e.target.value)}
                            className="w-5 h-5 rounded border border-gray-700 bg-transparent cursor-pointer"
                          />
                        </div>
                      </div>

                      {/* Image Upload Box & Sizing Inputs */}
                      <div className="flex flex-col gap-2 mt-1">
                        {part.decalImage ? (
                          <div className="flex items-center justify-between w-full bg-gray-950 p-1.5 rounded-lg border border-gray-800">
                            <img src={part.decalImage} alt="Decal" className="w-8 h-8 object-cover rounded" />
                            <span className="text-[10px] text-green-400 font-medium">Graphic Ready</span>
                            <button 
                              onClick={() => removeDecal(part.id)}
                              className="text-gray-500 hover:text-red-400 p-1 text-xs">
                              <i className="fa-solid fa-trash"></i>
                            </button>
                          </div>
                        ) : (
                          <label className="w-full bg-gray-950 hover:bg-gray-800 border border-dashed border-gray-700 p-2 rounded-lg text-center cursor-pointer transition block">
                            <span className="text-[11px] text-gray-400 flex items-center justify-center gap-1.5">
                              <i className="fa-solid fa-cloud-arrow-up text-red-500"></i> Upload {part.name} Graphic
                            </span>
                            <input 
                              type="file" 
                              accept="image/*" 
                              onChange={(e) => handleImageUpload(part.id, e)} 
                              className="hidden" 
                            />
                          </label>
                        )}

                        {/* Dimensions Sizing Controls */}
                        <div className="grid grid-cols-2 gap-2 text-[10px] bg-gray-950 p-1.5 rounded border border-gray-800">
                          <div>
                            <span className="text-gray-500 block">W (mm)</span>
                            <input 
                              type="number" 
                              value={part.widthMm}
                              onChange={(e) => updatePartProp(part.id, 'widthMm', parseInt(e.target.value) || 0)}
                              className="w-full bg-gray-900 border border-gray-700 rounded px-1.5 py-0.5 text-white font-mono focus:border-red-500"
                            />
                          </div>
                          <div>
                            <span className="text-gray-500 block">H (mm)</span>
                            <input 
                              type="number" 
                              value={part.heightMm}
                              onChange={(e) => updatePartProp(part.id, 'heightMm', parseInt(e.target.value) || 0)}
                              className="w-full bg-gray-900 border border-gray-700 rounded px-1.5 py-0.5 text-white font-mono focus:border-red-500"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            </div>

            {/* Right Interactive Viewport Area */}
            <div className="flex-1 bg-gray-950 flex flex-col p-4 overflow-hidden relative">

              {/* AI Studio View */}
              {activeTab === 'ai' && (
                <div className="w-full h-full flex flex-col bg-gray-900 rounded-2xl border border-gray-800 p-6 overflow-hidden">
                  <div className="flex justify-between items-center mb-4">
                    <div>
                      <h2 className="text-xl font-bold text-white flex items-center gap-2">
                        <i className="fa-solid fa-wand-magic-sparkles text-red-500"></i> AI Vehicle Render Studio
                      </h2>
                      <p className="text-xs text-gray-400">Generate high-fidelity renders of all vehicle angles incorporating your uploaded panel artwork</p>
                    </div>
                    <button 
                      onClick={generateAiVehicleRender}
                      disabled={isAiGenerating}
                      className="bg-red-600 hover:bg-red-500 disabled:bg-gray-700 text-white px-5 py-2.5 rounded-xl font-semibold shadow-lg transition flex items-center gap-2">
                      {isAiGenerating ? <i className="fa-solid fa-spinner fa-spin"></i> : <i className="fa-solid fa-bolt"></i>}
                      {isAiGenerating ? 'Generating Render...' : 'Generate AI Studio Render'}
                    </button>
                  </div>

                  {/* Perspective Angles */}
                  <div className="flex flex-wrap gap-2 mb-4 bg-gray-950 p-2.5 rounded-xl border border-gray-800">
                    {[
                      'Front 3/4 Left View', 
                      'Front 3/4 Right View', 
                      'Left Side Profile', 
                      'Right Side Profile', 
                      'Rear / Back View', 
                      'Roof / Top View',
                      'Full Studio Overview'
                    ].map(angle => (
                      <button 
                        key={angle}
                        onClick={() => setAiAngle(angle)}
                        className={`px-3 py-1.5 rounded-lg text-xs font-medium transition ${aiAngle === angle ? 'bg-red-600 text-white shadow-md' : 'bg-gray-800 text-gray-300 hover:bg-gray-700'}`}>
                        {angle}
                      </button>
                    ))}
                  </div>

                  {/* High-Res Image Viewport */}
                  <div className="flex-1 bg-gray-950 rounded-xl border border-gray-800 overflow-hidden relative">
                    <AiRenderDisplayCanvas 
                      aiImage={aiImage}
                      isGenerating={isAiGenerating}
                      error={aiError}
                      currentAngle={aiAngle}
                      onExpandImage={(img) => setExpandedImage(img)}
                    />
                  </div>
                </div>
              )}

              {/* Panels Overview Tab */}
              {activeTab === 'panels' && (
                <div className="w-full h-full bg-gray-900 rounded-2xl border border-gray-800 p-6 flex flex-col gap-4 overflow-y-auto">
                  <h2 className="text-xl font-bold text-white flex items-center gap-2">
                    <i className="fa-solid fa-layer-group text-red-500"></i> Active Panel Graphics Status
                  </h2>
                  <div className="grid grid-cols-3 gap-4">
                    {Object.values(vehicleParts).map(part => (
                      <div key={part.id} className="bg-gray-950 p-4 rounded-xl border border-gray-800 flex flex-col gap-2">
                        <div className="flex items-center justify-between">
                          <span className="font-bold text-sm text-white">{part.name}</span>
                          <span className={`text-[10px] px-2 py-0.5 rounded font-bold uppercase ${part.enabled ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-gray-800 text-gray-500'}`}>
                            {part.enabled ? 'Wrapped' : 'Unwrapped Paint'}
                          </span>
                        </div>
                        <div className="text-xs text-gray-400 font-mono">
                          Dimensions: {part.widthMm}mm × {part.heightMm}mm
                        </div>
                        {part.decalImage ? (
                          <img src={part.decalImage} alt="Decal preview" className="w-full h-24 object-contain bg-gray-900 rounded border border-gray-800 mt-2" />
                        ) : (
                          <div className="w-full h-24 bg-gray-900 rounded border border-dashed border-gray-800 flex items-center justify-center text-xs text-gray-600">
                            No Graphic Uploaded
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Cut-Sheet Production Specifications Tab */}
              {activeTab === 'cutsheet' && (
                <div className="w-full h-full bg-gray-900 rounded-2xl border border-gray-800 p-6 flex flex-col gap-6 overflow-y-auto">
                  <div className="flex items-center justify-between">
                    <div>
                      <h2 className="text-xl font-bold text-white flex items-center gap-2">
                        <i className="fa-solid fa-ruler-combined text-red-500"></i> Millimeter Production Cut-Sheet
                      </h2>
                      <p className="text-xs text-gray-400">Vinyl roll material estimation and exact panel bounding box measurements</p>
                    </div>
                    <div className="bg-gray-950 border border-gray-800 px-4 py-2 rounded-xl text-right">
                      <span className="text-xs text-gray-400 block">Total Wrapped Area</span>
                      <span className="text-lg font-bold text-red-500 font-mono">{calculateTotalWrapArea()} m²</span>
                    </div>
                  </div>

                  <table className="w-full text-left text-xs border-collapse">
                    <thead>
                      <tr className="bg-gray-950 text-gray-400 border-b border-gray-800 uppercase text-[10px] tracking-wider">
                        <th className="p-3">Panel Name</th>
                        <th className="p-3">Status</th>
                        <th className="p-3">Width (mm)</th>
                        <th className="p-3">Height (mm)</th>
                        <th className="p-3">Panel Area (m²)</th>
                        <th className="p-3">Graphic Attachment</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-800">
                      {Object.values(vehicleParts).map(part => {
                        const areaM2 = ((part.widthMm * part.heightMm) / 1000000).toFixed(3);
                        return (
                          <tr key={part.id} className="hover:bg-gray-950/50">
                            <td className="p-3 font-semibold text-white">{part.name}</td>
                            <td className="p-3">
                              <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${part.enabled ? 'bg-green-500/20 text-green-400' : 'bg-gray-800 text-gray-500'}`}>
                                {part.enabled ? 'WRAPPED' : 'PAINT'}
                              </span>
                            </td>
                            <td className="p-3 font-mono">{part.widthMm}</td>
                            <td className="p-3 font-mono">{part.heightMm}</td>
                            <td className="p-3 font-mono text-gray-300">{areaM2} m²</td>
                            <td className="p-3">
                              {part.decalImage ? <span className="text-green-400 font-medium">Uploaded Graphic</span> : <span className="text-gray-600">None</span>}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}

            </div>
          </div>

          {/* Full-Screen Lightbox Modal for Full Image View */}
          {expandedImage && (
            <div className="fixed inset-0 z-50 bg-black/95 backdrop-blur-md flex flex-col items-center justify-center p-4">
              <div className="absolute top-4 right-4 flex gap-3">
                <a 
                  href={expandedImage} 
                  download={`Signarama-${aiAngle.replace(/\s+/g, '-')}.png`}
                  className="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-lg transition flex items-center gap-2">
                  <i className="fa-solid fa-download"></i> Save Full Image
                </a>
                <button 
                  onClick={() => setExpandedImage(null)}
                  className="bg-gray-800 hover:bg-gray-700 text-white w-10 h-10 rounded-xl font-bold flex items-center justify-center transition">
                  <i className="fa-solid fa-xmark text-lg"></i>
                </button>
              </div>
              <img 
                src={expandedImage} 
                alt="Full High-Res View" 
                className="max-w-[95vw] max-h-[90vh] object-contain rounded-xl shadow-2xl border border-gray-800"
              />
            </div>
          )}

        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<SignaramaApp />);
  </script>
</body>
</html>
